# Environment and sensitive files
.env
.env.local
.env.*.local
*.pem
*.key
*.pub

# IDE and Editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Dependency directories
vendor/
node_modules/
composer.lock
package-lock.json

# Build artifacts
dist/
build/
*.tar.gz
*.zip

# Logs
logs/
*.log
app/logs/*.log

# Session files
app/storage/sessions/*
app/storage/cache/*
!app/storage/sessions/.gitkeep
!app/storage/cache/.gitkeep

# Upload directories (keep structure, ignore uploaded files)
app/public/uploads/avatars/*
app/public/uploads/documents/*
app/public/uploads/reports/*
!app/public/uploads/avatars/.gitkeep
!app/public/uploads/documents/.gitkeep
!app/public/uploads/reports/.gitkeep

# Testing
coverage/
phpunit.xml
.phpunit.result.cache

# Temporary files
tmp/
temp/
*.tmp

# Database backups
*.sql.gz
*.sql.backup
