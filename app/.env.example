# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=outsinc_pathways
DB_USER=root
DB_PASS=root

# Application Settings
APP_ENV=development
APP_URL=http://localhost:8080
APP_DEBUG=true

# Session Configuration
SESSION_TIMEOUT=1800
SESSION_SECURE=false

# Notification Settings
NOTIFICATION_FROM_EMAIL=noreply@outsinc.local
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Languages Enabled
LANGUAGES=en,fr

# Upload Settings
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=/workspaces/outsinc/app/public/uploads
